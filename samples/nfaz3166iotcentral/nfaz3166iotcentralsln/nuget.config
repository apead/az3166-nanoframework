<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- restore packages.config projects into the solution's packages folder (where the project's HintPaths point) -->
    <add key="repositoryPath" value="packages" />
    <add key="globalPackagesFolder" value="packages\.global" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
